
<%- include("partials/header") %>
<%- include("partials/navbar") %>

<div class="container my-5">
  <div class="d-flex justify-content-between mb-4">
    <h2>All Contents</h2>
    <a href="/content/create" class="btn btn-success">Add Content</a>
  </div>

  <div class="table-responsive">
    <table class="table table-bordered table-striped align-middle">
      <thead class="table-dark">
        <tr>
          <th>Thumbnail</th>
          <th>Title</th>
          <th>Category</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>

      <tbody>
        <% contents.forEach((content) => { %>
          <tr>
            <td>
              <img
                src="<%= content.thumbnail %>"
                alt="<%= content.title %>"
                width="80"
                height="60"
                style="object-fit: cover;"
              >
            </td>

            <td><%= content.title %></td>

            <td>
              <%
                const category = categories.find(
                  (item) => item.id === content.categoryId
                );
              %>
              <%= category ? category.name : "Category not found" %>
            </td>

            <td>
              <% if (content.status === "published") { %>
                <span class="badge bg-success">Published</span>
              <% } else { %>
                <span class="badge bg-secondary">Draft</span>
              <% } %>
            </td>

            <td>
              <a
                href="/content/<%= content.id %>/view"
                class="btn btn-primary btn-sm"
              >View</a>

              <a
                href="/content/<%= content.id %>/edit"
                class="btn btn-warning btn-sm"
              >Edit</a>

              <button
                class="btn btn-danger btn-sm"
                onclick="deleteContent('<%= content.id %>')"
              >Delete</button>
            </td>
          </tr>
        <% }) %>

        <% if (contents.length === 0) { %>
          <tr>
            <td colspan="5" class="text-center">No contents found.</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<script>
  function deleteContent(id) {
    if (!confirm("Are you sure you want to delete this content?")) return;

    fetch("/content/" + id, { method: "DELETE" })
      .then((res) => res.json())
      .then((result) => {
        alert(result.message);
        if (result.success) window.location.reload();
      });
  }
</script>

<%- include("partials/footer") %>
