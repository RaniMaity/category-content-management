
<%- include("partials/header") %>
<%- include("partials/navbar") %>

<div class="container my-5">
  <div class="text-center mb-5">
    <h1>Welcome to Our CMS</h1>
    <p class="text-muted">Explore categories and published contents</p>
  </div>

  <h2 class="mb-4">Categories</h2>

  <div class="row">
    <% categories.forEach((category) => { %>
      <div class="col-md-4 mb-4">
        <div class="card h-100">
          <img
            src="<%= category.imageurl %>"
            class="card-img-top"
            alt="<%= category.name %>"
            style="height: 200px; object-fit: cover;"
          >

          <div class="card-body">
            <h5 class="card-title"><%= category.name %></h5>
            <p class="card-text"><%= category.description %></p>

            <a
              href="/categories/<%= category.id %>/view"
              class="btn btn-primary"
            >
              View Category
            </a>
          </div>
        </div>
      </div>
    <% }) %>
  </div>

  <hr class="my-5">

  <h2 class="mb-4">Published Contents</h2>

  <div class="row">
    <% contents.forEach((content) => { %>
      <div class="col-md-4 mb-4">
        <div class="card h-100">
          <img
            src="<%= content.thumbnail %>"
            class="card-img-top"
            alt="<%= content.title %>"
            style="height: 200px; object-fit: cover;"
          >

          <div class="card-body">
            <h5 class="card-title"><%= content.title %></h5>
            <p class="card-text"><%= content.description %></p>

            <a
              href="/content/<%= content.id %>/view"
              class="btn btn-primary"
            >
              Read More
            </a>
          </div>
        </div>
      </div>
    <% }) %>

    <% if (contents.length === 0) { %>
      <p class="text-muted">No published contents available.</p>
    <% } %>
  </div>
</div>

<%- include("partials/footer") %>
